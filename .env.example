# Web build configuration. Copy to `.env` (gitignored) and fill in.
#
# The native iOS/Android shells embed whatever this file produces, so the same
# values must be supplied as GitHub Actions secrets when building in CI.

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Public app URL used for deep links and sharing.
VITE_APP_URL="https://gostudy.app"

# Folder that holds papers.json / books.json on Cloudflare R2. When unset the
# app has no offline catalogue and depends on Supabase alone.
VITE_CATALOG_URL=""
