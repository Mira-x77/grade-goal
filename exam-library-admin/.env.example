# Copy to .env and fill in values from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
VITE_SUPABASE_BUCKET=exam-papers
VITE_APP_URL=https://gostudy.app

# --- Cloudflare R2 (uploads) ---------------------------------------------
# R2 becomes a selectable destination in every upload form (it is the default
# once these are set). Supabase Storage stays available in the same picker.
# Values come from scripts/r2/.env (Cloudflare dashboard -> R2 -> Manage API tokens).
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET=gostudy
VITE_R2_PUBLIC_URL=https://pub-91f336347bd944c48d724d28d0d3b647.r2.dev

# Catalogue used for read-only admin lists when Supabase is restricted.
# Defaults to <VITE_R2_PUBLIC_URL>/catalog when unset.
VITE_CATALOG_URL=https://pub-91f336347bd944c48d724d28d0d3b647.r2.dev/catalog
