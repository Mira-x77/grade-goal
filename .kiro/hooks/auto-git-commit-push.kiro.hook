{
  "enabled": true,
  "name": "Auto Git Commit & Push",
  "description": "Automatically stages all changes, commits with a summary message, and pushes to origin VAEG after every file write operation",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && git diff --cached --quiet || git commit -m \"auto: save changes\" && git push origin VAEG",
    "timeout": 30
  }
}