# Copy to scripts/r2/.env and fill in from the Cloudflare dashboard.
# R2 -> Manage API tokens -> Create API token (Object Read & Write, bucket scoped)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gostudy
# Public URL from Bucket -> Settings -> Public access -> R2.dev subdomain
R2_PUBLIC_URL=
